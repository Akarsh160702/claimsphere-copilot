# Origin of the ClaimSphere FastAPI backend. Vite dev server proxies /api -> here.
VITE_BACKEND_ORIGIN=http://localhost:8000

# If set to "true", the UI uses bundled synthetic data and never calls the backend.
# Otherwise it calls the backend and falls back to synthetic data only when the
# backend is unreachable or returns no claims.
VITE_FORCE_DEMO=false
